# ===== Результаты сборки (g++) =====
build/
*.exe
*.o
*.obj
*.a
*.dll

# ===== Локальные файлы Visual Studio Code =====
# Файлы задач сборки и отладки (.vscode/tasks.json, launch.json) остаются
# в репозитории, исключаются только данные IntelliSense и истории
.vscode/ipch/
.vscode/*.db
.vscode/.browse*

# ===== Временные файлы Microsoft Office =====
~$*

# ===== Служебные файлы операционных систем =====
Thumbs.db
desktop.ini
.DS_Store

# ===== Логи =====
*.log
